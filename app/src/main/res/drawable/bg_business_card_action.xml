<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#FFF1F3F5" />
            <stroke android:width="1dp" android:color="#FFE1E5EA" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#FFDDE8FF" />
            <stroke android:width="1dp" android:color="@color/business_card_primary" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/business_card_surface" />
            <stroke android:width="1dp" android:color="@color/business_card_border" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</selector>
