<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="BusinessCard.ToolbarButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:minWidth">108dp</item>
        <item name="android:background">@drawable/bg_business_card_action</item>
        <item name="android:drawablePadding">7dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/business_card_text_primary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="BusinessCard.PropertyActionButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:minWidth">96dp</item>
        <item name="android:background">@drawable/bg_business_card_action</item>
        <item name="android:drawablePadding">6dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/business_card_text_primary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="BusinessCard.BottomButton" parent="Widget.AppCompat.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:drawablePadding">7dp</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="BusinessCard.SectionTitle" parent="TextAppearance.AppCompat.Body1">
        <item name="android:textColor">@color/business_card_text_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="BusinessCard.PropertyLabel" parent="TextAppearance.AppCompat.Body1">
        <item name="android:textColor">@color/business_card_text_primary</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
