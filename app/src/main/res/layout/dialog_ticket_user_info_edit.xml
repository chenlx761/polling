<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_white"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/edit_user_info_title"
            android:textColor="@color/text_color333"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            style="@style/TicketUserInfoDialogLabel"
            android:text="@string/belonging_area" />

        <EditText
            android:id="@+id/etDialogArea"
            style="@style/TicketUserInfoDialogInput"
            android:clickable="true"
            android:cursorVisible="false"
            android:focusable="false"
            android:hint="@string/area_input_hint"
            android:inputType="none" />

        <TextView
            style="@style/TicketUserInfoDialogLabel"
            android:text="@string/user_address" />

        <EditText
            android:id="@+id/etDialogAddress"
            style="@style/TicketUserInfoDialogInput"
            android:hint="@string/address_input_hint"
            android:inputType="textPostalAddress"
            android:maxLines="2" />

        <TextView
            style="@style/TicketUserInfoDialogLabel"
            android:text="@string/user_name_label" />

        <EditText
            android:id="@+id/etDialogName"
            style="@style/TicketUserInfoDialogInput"
            android:hint="@string/user_name_input_hint"
            android:inputType="textPersonName"
            android:maxLines="1" />

        <TextView
            style="@style/TicketUserInfoDialogLabel"
            android:text="@string/account_number" />

        <EditText
            android:id="@+id/etDialogAccount"
            style="@style/TicketUserInfoDialogInput"
            android:hint="@string/account_input_hint"
            android:inputType="text"
            android:maxLines="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvDialogCancel"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_f5f9ff_radius_5"
                android:gravity="center"
                android:text="@string/common_cancel"
                android:textColor="@color/primary"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvDialogConfirm"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_blue_radius_5"
                android:gravity="center"
                android:text="@string/common_confirm"
                android:textColor="@color/white"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
