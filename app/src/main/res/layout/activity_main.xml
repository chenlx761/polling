<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <TextView
            android:id="@+id/tv_start_location"
            android:gravity="center"
            android:text="测试定位"
            android:textColor="@color/white"
            android:layout_marginBottom="20dp"
            android:background="@color/red_color"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/tv_start"
            android:layout_width="100dp"
            android:layout_height="100dp"/>
        <TextView
            android:id="@+id/tv_start"
            android:gravity="center"
            android:text="启动通道"
            android:textColor="@color/white"
            android:layout_marginBottom="20dp"
            android:background="@color/red_color"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/tv_init"
            android:layout_width="100dp"
            android:layout_height="100dp"/>
        <TextView
            android:id="@+id/tv_init"
            android:gravity="center"
            android:text="初始化并激活"
            android:textColor="@color/white"
            android:background="@color/red_color"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_width="100dp"
            android:layout_height="100dp"/>

        <TextView
            android:id="@+id/tv_get_tsid"
            android:gravity="center"
            android:text="获取tsid"
            android:textColor="@color/white"
            android:layout_marginTop="20dp"
            android:background="@color/red_color"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_init"
            android:layout_width="100dp"
            android:layout_height="100dp"/>

        <TextView
            android:id="@+id/tv_get_info"
            android:gravity="center"
            android:text="测试接口"
            android:textColor="@color/white"
            android:layout_marginTop="20dp"
            android:background="@color/red_color"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_get_tsid"
            android:layout_width="100dp"
            android:layout_height="100dp"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>