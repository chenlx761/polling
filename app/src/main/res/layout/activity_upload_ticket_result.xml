<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background">

        <com.chenming.common.base.widget.MyTitleBar
            android:id="@+id/my_title_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fitsSystemWindows="true"
            app:layout_constraintTop_toTopOf="parent"
            app:titleBarBackground="@color/white"
            app:titleBarLeftImg="@mipmap/top_back"
            app:titleBarTitle="@string/upload_ticket_file_title"
            app:titleBarTitleColor="#24365B" />

        <ImageView
            android:id="@+id/iv_result_icon"
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="56dp"
            android:adjustViewBounds="true"
            android:contentDescription="@null"
            android:src="@mipmap/import_hint_success"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/my_title_bar" />

        <TextView
            android:id="@+id/tv_result_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/upload_ticket_result_success_title"
            android:textColor="#222222"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/iv_result_icon" />

        <TextView
            android:id="@+id/tv_result_desc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginHorizontal="48dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="@string/upload_ticket_result_failed_default_reason"
            android:textColor="#9C9C9C"
            android:textSize="14sp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_result_title" />

        <Button
            android:id="@+id/btn_retry"
            android:layout_width="216dp"
            android:layout_height="56dp"
            android:layout_marginTop="26dp"
            android:background="@drawable/bg_blue_radius_10"
            android:text="@string/upload_ticket_result_retry"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_result_desc" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_success_actions"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="54dp"
            android:layout_marginHorizontal="40dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_result_title">

            <Button
                android:layout_marginVertical="2dp"
                android:id="@+id/btn_back"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginEnd="18dp"
                android:background="@drawable/bg_gray_radius_10"
                android:text="@string/upload_ticket_result_back"
                android:textAllCaps="false"
                android:textColor="#333333"
                android:textSize="18sp"
                app:layout_constraintEnd_toStartOf="@id/btn_preview"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_percent="0.46" />

            <Button
                android:layout_marginVertical="2dp"
                android:id="@+id/btn_preview"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_blue_radius_10"
                android:text="@string/upload_ticket_result_preview"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="18sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/btn_back"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_percent="0.46" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
