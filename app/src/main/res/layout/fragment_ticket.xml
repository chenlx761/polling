<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:background="#F6F7FB"
        android:layout_height="match_parent">

        <com.chenming.common.base.widget.MyTitleBar
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fitsSystemWindows="true"
            android:id="@+id/my_title_bar"
            app:layout_constraintTop_toTopOf="parent"
            app:titleBarBackground="@color/white"
            app:titleBarTitle="@string/main_ticket" />


        <com.scwang.smart.refresh.layout.SmartRefreshLayout
            android:id="@+id/srl_flash"
            android:layout_width="match_parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/my_title_bar"
            android:layout_height="0dp">


            <com.scwang.smart.refresh.header.MaterialHeader
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_ticket"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </com.scwang.smart.refresh.layout.SmartRefreshLayout>






    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>